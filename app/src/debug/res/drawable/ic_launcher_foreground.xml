<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: replaces src/main's foreground with the same hourglass
  inside a thin blue ring, so the .debug app is easy to tell from the release
  app. Gradle uses this file instead of the one in src/main/res for debug
  builds, because the debug source set overrides resources of the same name.

  The hourglass is scaled to 84% here (90% in src/main) to leave room for the
  ring. Its farthest point, a corner plus half the line width, is then about
  128 units from the centre; the ring covers 145 to 155 units, inside the
  66dp safe zone (a radius of about 156 of the 512 units).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.84"
        android:scaleY="0.84">
        <!-- The outline: top bar, waist and bottom bar as one closed path. -->
        <path
            android:pathData="M176,136 H336 L256,256 L336,376 H176 L256,256 Z"
            android:strokeColor="@color/ic_launcher_hourglass"
            android:strokeWidth="44"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- The sand settled in the bottom half. -->
        <path
            android:pathData="M230,342 H282 L256,306 Z"
            android:fillColor="@color/ic_launcher_sand"
            android:strokeColor="@color/ic_launcher_sand"
            android:strokeWidth="10"
            android:strokeLineJoin="round" />
    </group>
    <!--
      Debug builds only: the ring, a circle of radius 150 around the centre
      drawn as two half-circle arcs (vector paths have no circle command),
      stroked 10 units wide and not filled. It is outside the 84% group, so
      it is not scaled.
    -->
    <path
        android:pathData="M106,256 A150,150 0 1,0 406,256 A150,150 0 1,0 106,256 Z"
        android:strokeColor="@color/ic_launcher_debug_ring"
        android:strokeWidth="10" />
</vector>
