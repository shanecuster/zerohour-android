<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon: three layers the launcher stacks and cuts into
  its own shape (circle, squircle, rounded square). Adaptive icons exist since
  Android 8 (API 26), the app's minimum, so no PNG versions are needed.

  - background: a plain colour (Catppuccin Macchiato "base");
  - foreground: the hourglass, inside the 66dp safe zone;
  - monochrome: the same shapes, for themed icons on Android 13+.

  ic_launcher.xml and ic_launcher_round.xml are the same icon: some launchers
  ask for the "round" one by name (the manifest's roundIcon).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
