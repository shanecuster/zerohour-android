<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's colours, from the artwork in third_party/icon/
  (Catppuccin Macchiato palette). These are the icon's own colours: the app's
  screens never use them (those colours come from zerohour's themes).
-->
<resources>
    <!-- Background layer: Catppuccin Macchiato "base", a dark navy. -->
    <color name="ic_launcher_background">#24273A</color>
    <!-- The hourglass outline: Macchiato "green". -->
    <color name="ic_launcher_hourglass">#A6DA95</color>
    <!-- The sand in the bottom half: Macchiato "peach" (Catppuccin's orange). -->
    <color name="ic_launcher_sand">#F5A97F</color>
</resources>
