<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: the app's "identity card", read by Android before any of
  our code runs. It declares what the app is called, which screen opens first,
  and which special abilities (permissions) the app asks the user for.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET lets the app reach the user's own sync server (an opt-in feature,
      off by default). It is a "normal" permission: Android grants it at install
      time and never shows a prompt.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The reminder permissions. Reminders are off until switched on in
      Settings > Reminders, and everything about them stays on the phone.

      POST_NOTIFICATIONS: show reminder notifications. On Android 13 and later
      the app asks when reminders are switched on; older versions grant it at
      install (the user can still block notifications in the system settings).

      SCHEDULE_EXACT_ALARM: fire a reminder at its minute ("Alarms & reminders"
      in the system settings). Off by default on Android 14 and later until the
      user allows it; without it, reminders use inexact alarms, which may come
      up to about an hour late. Not USE_EXACT_ALARM: Google Play keeps that one
      for alarm-clock and calendar apps.

      RECEIVE_BOOT_COMPLETED: set the alarms again after the phone restarts
      (Android forgets every alarm on a restart). A normal permission, granted
      at install.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Zerohour"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <!--
          allowBackup="false": do not copy the app's private data into Google's
          cloud backups (or out with `adb backup`). Tasks, events and the
          encrypted sync password stay on the device unless the user turns on
          sync to their own server.

          dataExtractionRules: on Android 12 and later, allowBackup="false"
          alone still lets a new phone copy the app's data during setup
          (device-to-device transfer). The rules file excludes everything from
          that too. Older Android versions only read allowBackup.

          usesCleartextTraffic="false": no plain http:// from Android's own
          network code. Sync runs in Rust with its own connections, which this
          setting cannot see, so the Rust side refuses non-https addresses
          itself; this is a second guard.

          icon / roundIcon: the adaptive hourglass icon in res/mipmap-anydpi
          (artwork and licence: third_party/icon/README.md). Debug builds
          replace its foreground with a badged one (src/debug/res), so the
          .debug app is easy to tell apart on the home screen.
        -->

        <!--
          The one screen. `exported="true"` is required for the screen that the
          launcher starts. The <intent-filter> says "this is the app's main
          entry point and should appear in the app drawer".
        -->
        <!--
          windowSoftInputMode="adjustResize": when the keyboard opens, the
          screen shrinks to the space above it (instead of the keyboard
          covering the add/edit form), so the field being typed in stays
          visible.

          configChanges: by default Android destroys and rebuilds the screen
          when the phone is turned, which would throw away a half-filled
          add/edit form. Listing these changes says "the app handles them
          itself": the screen stays, and Compose simply lays it out again for
          the new size (narrow or wide), keeping everything it remembers.
          orientation and screenSize change on a turn; screenLayout and
          keyboardHidden cover the shape of the screen and a hardware keyboard
          being attached or removed.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Reminder receivers (code in reminders/). A receiver is a piece of
          the app Android wakes up to handle one message, even when the app
          is not open.

          The alarm and Done receivers are exported="false": only the app's
          own alarms and notification buttons can reach them.
        -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderDoneReceiver"
            android:exported="false" />

        <!--
          Re-plans the alarms after system events: a restart, the clock or
          time zone changing, an app update, and exact alarms being allowed.
          exported="true" so Android can deliver them; they are protected
          broadcasts that only the system can send.
        -->
        <receiver
            android:name=".reminders.ReminderEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
